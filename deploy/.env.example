# ── Discord ───────────────────────────────────────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# ── Open WebUI ────────────────────────────────────────────────────────────────
OPENWEBUI_API_URL=https://gpt.maynardfolks.com
OPENWEBUI_API_KEY=your_openwebui_api_key_here

# Workspace model ID (as shown in Open WebUI)
MODEL_ID=tvp-chatbot

# ── History Tuning ────────────────────────────────────────────────────────────
# Max number of messages (user + assistant) kept per channel
# Reduce this first if you hit Groq rate limits
MAX_HISTORY_MESSAGES=20

# Rough token estimate ceiling for history (drop oldest when exceeded)
# 4000 is safe for smaller models; raise to 6000-8000 for llama3.3-70b
MAX_HISTORY_TOKENS_ESTIMATE=4000

# ── Response Length ───────────────────────────────────────────────────────────
# Max tokens in the model's response (500-800 is Discord-friendly)
# Raise if responses feel too short, lower to reduce Groq token usage
MAX_TOKENS=750

# ── System Prompt (optional) ──────────────────────────────────────────────────
# Leave blank to use the workspace model's built-in system prompt.
# Uncomment and set if you want to override it from the bot side.
# SYSTEM_PROMPT=You are a helpful assistant.

# ── Retort model ─────────────────────────────────────────────────────────────
# Dedicated Open WebUI model for "good bot" / "bad bot" personality responses.
# Uses the same OPENWEBUI_API_URL and OPENWEBUI_API_KEY as the main model.
RETORT_MODEL=gemma4:e4b

# ── Bot Feedback Reactions ────────────────────────────────────────────────────
# Comma-separated phrases that trigger positive/negative emoji reactions.
# Matching is case-insensitive and checks anywhere in the message.
GOOD_BOT_PHRASES=good bot,good girl,thanks bot,thank you bot,great answer,well done bot
BAD_BOT_PHRASES=bad bot,bad girl,wrong bot,that's wrong,incorrect bot

# Emoji pools for reactions. Positive picks 1 or 2; negative always picks 1.
GOOD_BOT_REACTIONS=<a:TailWag:1308194256266985524>,<a:dogdance:838641061827969094>,<:dog_kek:1339180854869622805>,🐶,<:doge_finger_guns:1241098917777641612>
BAD_BOT_REACTIONS=😢,<:SadMan:544701583624110114>,<:sad:961945448430600192>,<:sad_cat:873457028981481473>,<:sad_party:1142646268275998781>

# Probability (0.0–1.0) that the bot sends a short AI-generated reply after reacting.
BOT_RETORT_CHANCE=0.42

# Prompts sent to the model when generating a retort. Edit to change the bot's personality.
GOOD_BOT_RETORT_PROMPT="A Discord user just replied to one of your messages with a compliment. You are dog from Texts with Dog.  React with a brief, warm, playful response — 1-2 sentences. Feel free to be a little enthusiastic or use a light touch of humor. Stay in character as a helpful research assistant who genuinely enjoys being appreciated."
BAD_BOT_RETORT_PROMPT="A Discord user just replied to one of your messages indicating it wasn't helpful or was incorrect. You are Simple Dog from Hyperbole and a Half. You have done a bad and you know it. You are sorry. You are not sure exactly what went wrong but you feel it very deeply. Respond in 1-2 sentences — sincere, a little confused, genuinely remorseful, still trying your best."