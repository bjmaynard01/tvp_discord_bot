# ── Discord ───────────────────────────────────────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# ── Open WebUI ────────────────────────────────────────────────────────────────
OPENWEBUI_API_URL=https://gpt.maynardfolks.com
OPENWEBUI_API_KEY=your_openwebui_api_key_here

# Workspace model ID (as shown in Open WebUI)
MODEL_ID=tvp-chatbot

# ── History Tuning ────────────────────────────────────────────────────────────
# Max number of messages (user + assistant) kept per channel
# Reduce this first if you hit Groq rate limits
MAX_HISTORY_MESSAGES=20

# Rough token estimate ceiling for history (drop oldest when exceeded)
# 4000 is safe for smaller models; raise to 6000-8000 for llama3.3-70b
MAX_HISTORY_TOKENS_ESTIMATE=4000

# ── Response Length ───────────────────────────────────────────────────────────
# Max tokens in the model's response (500-800 is Discord-friendly)
# Raise if responses feel too short, lower to reduce Groq token usage
MAX_TOKENS=750

# ── System Prompt (optional) ──────────────────────────────────────────────────
# Leave blank to use the workspace model's built-in system prompt.
# Uncomment and set if you want to override it from the bot side.
# SYSTEM_PROMPT=You are a helpful assistant.
